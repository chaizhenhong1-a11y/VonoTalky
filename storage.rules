rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /chat_media/{roomId}/{userId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid in
                     firestore.get(/databases/(default)/documents/conversations/$(roomId)).data.memberIds;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.auth.uid in
                      firestore.get(/databases/(default)/documents/conversations/$(roomId)).data.memberIds
                   && (
                     (request.resource.size < 10 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*'))
                     ||
                     (request.resource.size < 25 * 1024 * 1024
                      && request.resource.contentType.matches('audio/.*'))
                     ||
                     (request.resource.size < 25 * 1024 * 1024
                      && request.resource.name.matches('.*[.](pdf|doc|docx|xls|xlsx|ppt|pptx|txt|zip)$'))
                   );
    }

    match /group_media/{groupId}/{userId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid in
                     firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.auth.uid in
                      firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds
                   && (
                     (request.resource.size < 10 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*'))
                     ||
                     (request.resource.size < 25 * 1024 * 1024
                      && request.resource.contentType.matches('audio/.*'))
                     ||
                     (request.resource.size < 25 * 1024 * 1024
                      && request.resource.name.matches('.*[.](pdf|doc|docx|xls|xlsx|ppt|pptx|txt|zip)$'))
                   );
    }

    match /group_avatars/{groupId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (
                     request.auth.uid ==
                       firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId
                     || request.auth.uid in
                       firestore.get(/databases/(default)/documents/groups/$(groupId)).data.adminIds
                   )
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
